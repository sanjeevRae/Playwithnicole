
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function accountIsCleared(userId) {
      return exists(
          /databases/$(database)/documents/accountStates/$(userId)
        ) &&
        get(
          /databases/$(database)/documents/accountStates/$(userId)
        ).data.status in ['data_clearing', 'data_cleared'];
    }

    function isOwner(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        !accountIsCleared(userId);
    }

    function userDocumentExists() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isAdmin() {
      return userDocumentExists() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    // Application-data clearing must never be allowed to target an admin,
    // even if a caller bypasses the React UI and calls Firestore directly.
    function targetIsNotAdmin(userId) {
      return !exists(
          /databases/$(database)/documents/users/$(userId)
        ) ||
        get(
          /databases/$(database)/documents/users/$(userId)
        ).data.role != 'admin';
    }

    // ==========================================
    // USER PROFILE HELPERS
    // ==========================================

    function safeInitialUserRole() {
      return !('role' in request.resource.data) ||
        request.resource.data.role in [
          'member',
          'player',
          'user'
        ];
    }

    function safeInitialAdminFlag() {
      return !('isAdmin' in request.resource.data) ||
        request.resource.data.isAdmin == false;
    }

    function safeInitialAdminRoleFlag() {
      return !('admin' in request.resource.data) ||
        request.resource.data.admin == false;
    }

    function safeInitialVerification() {
      return !('verified' in request.resource.data) ||
        (request.resource.data.verified == false ||
          request.resource.data.verified == 0);
    }

    function validUserProfileUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'displayName',
          'name',
          'username',
          'bio',
          'photoURL',
          'preferences',
          'updatedAt'
        ]) &&
        (!('displayName' in request.resource.data) ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() <= 100)) &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string &&
            request.resource.data.name.size() <= 100)) &&
        (!('username' in request.resource.data) ||
          (request.resource.data.username is string &&
            (request.resource.data.username == '' ||
              request.resource.data.username.matches('^[a-zA-Z0-9_.]{3,24}$')))) &&
        (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string &&
            request.resource.data.bio.size() <= 160)) &&
        (!('photoURL' in request.resource.data) ||
          (request.resource.data.photoURL is string &&
            request.resource.data.photoURL.size() <= 2048)) &&
        (!('updatedAt' in request.resource.data) ||
          request.resource.data.updatedAt is timestamp) &&
        (
          !('preferences' in request.resource.data) ||
          (
            request.resource.data.preferences is map &&
            request.resource.data.preferences.keys().hasOnly([
              'emailNotifications',
              'communityUpdates',
              'profileVisible'
            ]) &&
            (!('emailNotifications' in request.resource.data.preferences) ||
              request.resource.data.preferences.emailNotifications is bool) &&
            (!('communityUpdates' in request.resource.data.preferences) ||
              request.resource.data.preferences.communityUpdates is bool) &&
            (!('profileVisible' in request.resource.data.preferences) ||
              request.resource.data.preferences.profileVisible is bool)
          )
        );
    }

    // ==========================================
    // ACCOUNT ACCESS STATE
    // Admin-only marker used after an application-data clear.
    // The Firebase Auth identity still exists, but cleared users are
    // blocked from accessing or recreating their Firestore profile.
    // ==========================================

    match /accountStates/{userId} {
      // The affected user can read the tombstone so the client can detect
      // a cleared account and sign out. Only admins can create/update it.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      allow create: if isAdmin() &&
        targetIsNotAdmin(userId) &&
        request.resource.data.keys().hasAll([
          'status', 'clearStartedAt', 'clearStartedBy'
        ]) &&
        request.resource.data.keys().hasOnly([
          'status', 'clearStartedAt', 'clearStartedBy'
        ]) &&
        request.resource.data.status == 'data_clearing' &&
        request.resource.data.clearStartedAt is timestamp &&
        request.resource.data.clearStartedBy == request.auth.uid;

      allow update: if isAdmin() &&
        targetIsNotAdmin(userId) &&
        resource.data.status == 'data_clearing' &&
        request.resource.data.status in ['data_clearing', 'data_cleared'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'clearStartedAt', 'clearStartedBy',
          'clearedAt', 'clearedBy'
        ]) &&
        request.resource.data.clearStartedAt is timestamp &&
        request.resource.data.clearStartedBy is string &&
        (
          request.resource.data.status != 'data_cleared' ||
          (
            request.resource.data.clearedAt is timestamp &&
            request.resource.data.clearedBy == request.auth.uid
          )
        );

      // A cleared-account marker is intentionally permanent.
      allow delete: if false;
    }

    // ==========================================
    // ACCOUNT DELETION REQUESTS
    // ==========================================

    match /accountDeletionRequests/{requestId} {
      allow create: if isSignedIn() &&
        !accountIsCleared(request.auth.uid) &&
        request.resource.data.keys().hasAll([
          'userId', 'username', 'email', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId', 'username', 'email', 'status', 'createdAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 24 &&
        request.resource.data.email is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // USER PROFILES
    // Path: users/{userId}
    // ==========================================

    match /users/{userId} {

      // Users can read their own profiles.
      // Admins can read all profiles.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own normal profile.
      // Admins can create profiles and assign roles.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        !accountIsCleared(userId) &&
        safeInitialUserRole() &&
        safeInitialAdminFlag() &&
        safeInitialAdminRoleFlag() &&
        safeInitialVerification()
      );

      // Users can update only their profile fields.
      // Admins can update user roles and verification.
      allow update: if (
        isOwner(userId) &&
        validUserProfileUpdate()
      ) || isAdmin();

      // Only admins can delete user profiles.
      allow delete: if isAdmin() &&
        userId != request.auth.uid &&
        resource.data.role != 'admin';

      // ==========================================
      // USER NOTIFICATIONS
      // Path: users/{userId}/notifications/{notificationId}
      // ==========================================

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();

        function validNotification() {
          return request.resource.data.keys().hasAll([
              'title', 'body', 'type', 'read', 'createdAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'title', 'body', 'type', 'read', 'createdAt', 'readAt'
            ]) &&
            request.resource.data.title is string &&
            request.resource.data.title.size() <= 120 &&
            request.resource.data.body is string &&
            request.resource.data.body.size() <= 1000 &&
            request.resource.data.type in [
              'support', 'verification', 'general'
            ] &&
            request.resource.data.read is bool &&
            request.resource.data.createdAt is timestamp;
        }

        allow create: if isAdmin() && validNotification();
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'readAt'
          ]) &&
          request.resource.data.read == true &&
          request.resource.data.readAt is timestamp;
        allow delete: if isOwner(userId) || (isAdmin() && targetIsNotAdmin(userId));
      }

      // ==========================================
      // FAVORITE GAMES
      // Path: users/{userId}/favorites/{gameId}
      // ==========================================

      match /favorites/{gameId} {

        allow read: if isOwner(userId) || isAdmin();

        function validFavorite() {
          return request.resource.data.keys().hasAll([
              'gameId',
              'title',
              'description',
              'image',
              'categories',
              'favoritedAt',
              'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'gameId',
              'title',
              'description',
              'image',
              'categories',
              'favoritedAt',
              'updatedAt'
            ]) &&
            request.resource.data.gameId == gameId &&
            request.resource.data.title is string &&
            request.resource.data.description is string &&
            request.resource.data.image is string &&
            request.resource.data.categories is list &&
            request.resource.data.favoritedAt is timestamp &&
            request.resource.data.updatedAt is timestamp &&
            request.resource.data.title.size() <= 200 &&
            request.resource.data.description.size() <= 5000 &&
            request.resource.data.categories.size() <= 30;
        }

        allow create, update: if isOwner(userId) &&
          validFavorite();

        allow delete: if isOwner(userId) || (isAdmin() && targetIsNotAdmin(userId));
      }

      // ==========================================
      // RECENTLY PLAYED GAMES
      // Path: users/{userId}/recentGames/{gameId}
      // ==========================================

      match /recentGames/{gameId} {

        allow read: if isOwner(userId) || isAdmin();

        function validRecentGame() {
          return request.resource.data.keys().hasAll([
              'gameId',
              'title',
              'description',
              'image',
              'categories',
              'openedAt',
              'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'gameId',
              'title',
              'description',
              'image',
              'categories',
              'openedAt',
              'updatedAt',
              'playedAt'
            ]) &&
            request.resource.data.gameId == gameId &&
            request.resource.data.title is string &&
            request.resource.data.description is string &&
            request.resource.data.image is string &&
            request.resource.data.categories is list &&
            request.resource.data.openedAt is timestamp &&
            request.resource.data.updatedAt is timestamp &&
            request.resource.data.title.size() <= 200 &&
            request.resource.data.description.size() <= 5000 &&
            request.resource.data.categories.size() <= 30 &&
            (
              !('playedAt' in request.resource.data) ||
              request.resource.data.playedAt is timestamp
            );
        }

        allow create, update: if isOwner(userId) &&
          validRecentGame();

        allow delete: if isOwner(userId) || (isAdmin() && targetIsNotAdmin(userId));
      }
    }

    // ==========================================
    // GAMES
    // Collection: games
    // ==========================================

    match /games/{gameId} {

      // Admins can read all games, including drafts.
      // Normal users can read published and visible games.
      allow read: if isAdmin() ||
        (
          resource.data.status == 'Published' &&
          resource.data.visible == true
        );

      // Only admins can manage games.
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // SOCIAL LINKS
    // Document: siteSettings/socialLinks
    // ==========================================

    match /siteSettings/{settingId} {

      // This is the important permission for your
      // homepage and Social Connections page.
      //
      // Anyone can read socialLinks without signing in.
      // Only admins can read other settings.
      allow read: if settingId == 'socialLinks' ||
        isAdmin();

      // Only admins can create, update, or delete settings.
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // HERO BANNERS
    // Collection: heroBanners
    // ==========================================

    match /heroBanners/{bannerId} {

      // Public users can only read active, visible banners.
      // Admins can read all banners.
      allow read: if isAdmin() ||
        (
          resource.data.visible == true &&
          resource.data.isActive == true
        );

      // Only admins can manage hero banners.
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // SUPPORT CONVERSATION HELPERS
    // ==========================================

    function validUserConversationCreate(userId) {
      return request.resource.data.keys().hasAll([
          'userId',
          'status',
          'lastMessage',
          'lastMessageType',
          'lastMessageSenderId',
          'lastMessageAt',
          'updatedAt',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId',
          'status',
          'lastMessage',
          'lastMessageType',
          'lastMessageSenderId',
          'lastMessageAt',
          'updatedAt',
          'createdAt'
        ]) &&
        request.resource.data.userId == userId &&
        request.resource.data.status == 'open' &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessageType in [
          'text',
          'image'
        ] &&
        request.resource.data.lastMessageSenderId ==
          request.auth.uid &&
        request.resource.data.lastMessageAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.createdAt is timestamp;
    }

    function validUserConversationUpdate(userId) {
      return request.resource.data.userId == userId &&
        request.resource.data.status == 'open' &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessageType in [
          'text',
          'image'
        ] &&
        request.resource.data.lastMessageSenderId ==
          request.auth.uid &&
        request.resource.data.lastMessageAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'lastMessage',
            'lastMessageType',
            'lastMessageSenderId',
            'lastMessageAt',
            'updatedAt'
          ]);
    }

    // ==========================================
    // SUPPORT CONVERSATIONS
    // Path: supportConversations/{userId}
    // ==========================================

    match /supportConversations/{userId} {

      // Users can access only their own conversation.
      // Admins can access all support conversations.
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own conversation.
      allow create: if isOwner(userId) &&
        validUserConversationCreate(userId);

      // Users can send a message and reopen a resolved chat.
      // Admins can update conversation status and metadata.
      allow update: if (
        isOwner(userId) &&
        validUserConversationUpdate(userId)
      ) || (
        isAdmin() &&
        request.resource.data.userId == userId
      );

      // Only admins can delete support conversations.
      allow delete: if isAdmin() && targetIsNotAdmin(userId);

      // ==========================================
      // SUPPORT MESSAGES
      // Path:
      // supportConversations/{userId}/messages/{messageId}
      // ==========================================

      match /messages/{messageId} {

        // Only the conversation owner and admins can read.
        allow read: if isOwner(userId) || isAdmin();

        function validMessage() {
          return request.resource.data.keys().hasAll([
              'senderId',
              'senderRole',
              'type',
              'text',
              'imageUrl',
              'createdAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'senderId',
              'senderRole',
              'type',
              'text',
              'imageUrl',
              'createdAt'
            ]) &&
            request.resource.data.senderId ==
              request.auth.uid &&
            request.resource.data.senderRole in [
              'user',
              'admin'
            ] &&
            request.resource.data.type in [
              'text',
              'image'
            ] &&
            request.resource.data.text is string &&
            request.resource.data.imageUrl is string &&
            request.resource.data.text.size() <= 4000 &&
            request.resource.data.createdAt is timestamp;
        }

        // Normal users can only send messages as themselves.
        allow create: if isOwner(userId) &&
          validMessage() &&
          request.resource.data.senderRole == 'user' &&
          existsAfter(
            /databases/$(database)/documents/supportConversations/$(userId)
          );

        // Admins can reply as the Support Team.
        allow create: if isAdmin() &&
          validMessage() &&
          request.resource.data.senderRole == 'admin' &&
          existsAfter(
            /databases/$(database)/documents/supportConversations/$(userId)
          );

        // Messages cannot be edited. Admins may delete them when clearing
        // a member's application data after an approved deletion request.
        allow update: if false;
        allow delete: if isAdmin() && targetIsNotAdmin(userId);
      }
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================

    // Everything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
