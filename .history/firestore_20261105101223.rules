rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function adminUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminUserPath())
        && get(adminUserPath()).data.role == 'admin';
    }

    function changedUserFields() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys();
    }


    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {

      // ----------------------------------------
      // READ USERS
      // ----------------------------------------

      allow get, list: if isOwner(userId)
        || isAdmin();


      // ----------------------------------------
      // CREATE USER
      // ----------------------------------------

      allow create: if isOwner(userId)

        && (
          !request.resource.data.keys().hasAny([
            'role'
          ])

          ||

          request.resource.data.role in [
            'player',
            'user'
          ]
        )

        && (
          !request.resource.data.keys().hasAny([
            'verified'
          ])

          ||

          request.resource.data.verified == 0

          ||

          request.resource.data.verified == false
        );


      // ----------------------------------------
      // UPDATE USER
      // ----------------------------------------

      allow update: if

        (
          isAdmin()

          &&

          (
            userId != request.auth.uid

            ||

            !changedUserFields().hasAny([
              'role'
            ])
          )
        )

        ||

        (
          isOwner(userId)

          &&

          !changedUserFields().hasAny([
            'role',
            'verified'
          ])
        );


      // ----------------------------------------
      // DELETE USER
      // ----------------------------------------

      allow delete: if isOwner(userId)
        || isAdmin();


      // ==========================================
      // USER FAVORITES
      //
      // users/{userId}/favorites/{gameId}
      // ==========================================

      match /favorites/{gameId} {

        // Only the owner can read their favorites.
        allow get, list: if isOwner(userId);


        // Add or update a favorite.
        allow create, update: if

          isOwner(userId)

          && request.resource.data.keys().hasAll([
            'gameId',
            'title',
            'description',
            'image',
            'categories',
            'favoritedAt',
            'updatedAt'
          ])

          && request.resource.data.keys().hasOnly([
            'gameId',
            'title',
            'description',
            'image',
            'categories',
            'favoritedAt',
            'updatedAt'
          ])

          && request.resource.data.gameId == gameId

          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200

          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000

          && request.resource.data.image is string

          && request.resource.data.categories is list
          && request.resource.data.categories.size() <= 20

          && request.resource.data.favoritedAt == request.time

          && request.resource.data.updatedAt == request.time;


        // Users can remove their own favorites.
        allow delete: if isOwner(userId);
      }


      // ==========================================
      // RECENTLY PLAYED GAMES
      //
      // users/{userId}/recentGames/{gameId}
      // ==========================================

      match /recentGames/{gameId} {

        // Only the owner can read their activity.
        allow get, list: if isOwner(userId);


        // Create or update recent-game activity.
        allow create, update: if

          isOwner(userId)

          && request.resource.data.keys().hasAll([
            'gameId',
            'title',
            'description',
            'image',
            'categories',
            'openedAt',
            'updatedAt'
          ])

          && request.resource.data.keys().hasOnly([
            'gameId',
            'title',
            'description',
            'image',
            'categories',
            'openedAt',
            'playedAt',
            'updatedAt'
          ])

          && request.resource.data.gameId == gameId

          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200

          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000

          && request.resource.data.image is string

          && request.resource.data.categories is list
          && request.resource.data.categories.size() <= 20

          && request.resource.data.openedAt == request.time

          && request.resource.data.updatedAt == request.time

          && (
            !request.resource.data.keys().hasAny([
              'playedAt'
            ])

            ||

            request.resource.data.playedAt is timestamp
          );


        // Users can delete their own recent-game records.
        allow delete: if isOwner(userId);
      }
    }


    // ==========================================
    // PRIVATE SUPPORT CONVERSATIONS
    //
    // supportConversations/{userUid}
    //   messages/{messageId}
    // ==========================================

    match /supportConversations/{userId} {

      // ----------------------------------------
      // READ CONVERSATIONS
      // ----------------------------------------

      allow get: if isAdmin()
        || isOwner(userId);

      allow list: if isAdmin();


      // ----------------------------------------
      // CREATE CONVERSATION
      // ----------------------------------------

      allow create: if isOwner(userId)

        && request.resource.data.keys().hasAll([
          'userId',
          'status',
          'lastMessage',
          'lastMessageType',
          'lastMessageSenderId',
          'lastMessageAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasOnly([
          'userId',
          'status',
          'lastMessage',
          'lastMessageType',
          'lastMessageSenderId',
          'lastMessageAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.userId == userId

        && request.resource.data.status == 'open'

        && request.resource.data.lastMessage is string

        && request.resource.data.lastMessageSenderId
          == request.auth.uid

        && request.resource.data.lastMessageType in [
          'text',
          'image'
        ]

        && request.resource.data.lastMessageAt == request.time

        && request.resource.data.createdAt == request.time

        && request.resource.data.updatedAt == request.time;


      // ----------------------------------------
      // UPDATE CONVERSATION
      // ----------------------------------------

      allow update: if

        request.resource.data.userId == userId

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'lastMessage',
            'lastMessageType',
            'lastMessageSenderId',
            'lastMessageAt',
            'updatedAt'
          ])

        && request.resource.data.status in [
          'open',
          'resolved'
        ]

        && request.resource.data.updatedAt == request.time

        && (

          // Administrators can update conversation metadata.
          isAdmin()

          ||

          // Members can update their own conversation.
          (
            isOwner(userId)

            && request.resource.data.status == 'open'

            && request.resource.data.lastMessageSenderId
              == request.auth.uid

            && request.resource.data.lastMessageAt
              == request.time

            && request.resource.data.lastMessage is string

            && request.resource.data.lastMessageType in [
              'text',
              'image'
            ]
          )
        );


      allow delete: if false;


      // ==========================================
      // SUPPORT CHAT MESSAGES
      // ==========================================

      match /messages/{messageId} {

        // Conversation owner and administrators.
        allow get, list: if isAdmin()
          || isOwner(userId);


        // ----------------------------------------
        // SEND MESSAGE
        // ----------------------------------------

        allow create: if

          request.resource.data.keys().hasAll([
            'senderId',
            'senderRole',
            'type',
            'text',
            'imageUrl',
            'createdAt'
          ])

          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderRole',
            'type',
            'text',
            'imageUrl',
            'createdAt'
          ])

          && request.resource.data.createdAt == request.time

          && request.resource.data.text is string

          && request.resource.data.text.size() <= 4000

          && request.resource.data.imageUrl is string

          && request.resource.data.type in [
            'text',
            'image'
          ]

          && (

            // Member sends message.
            (
              isOwner(userId)

              && request.resource.data.senderId
                == request.auth.uid

              && request.resource.data.senderRole
                == 'user'
            )

            ||

            // Administrator replies.
            (
              isAdmin()

              && request.resource.data.senderId
                == request.auth.uid

              && request.resource.data.senderRole
                == 'admin'
            )
          )

          && (

            // Text message.
            (
              request.resource.data.type == 'text'

              && request.resource.data.text.size() > 0

              && request.resource.data.imageUrl == ''
            )

            ||

            // Cloudinary image message.
            (
              request.resource.data.type == 'image'

              && request.resource.data.imageUrl.matches(
                'https://res\\.cloudinary\\.com/.+'
              )
            )
          );


        // Messages cannot be edited or deleted.
        allow update, delete: if false;
      }
    }


    // ==========================================
    // MEDIA
    // ==========================================

    match /media/{mediaId} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }


    // ==========================================
    // GAMES
    // ==========================================

    match /games/{gameId} {

      // Public users can read published and visible games.
      // Administrators can read all games.
      allow read: if isAdmin()

        || (

          resource.data.status == 'Published'

          && resource.data.visible == true
        );

      // Only administrators can manage games.
      allow create, update, delete: if isAdmin();
    }


    // ==========================================
    // HERO BANNERS
    // ==========================================

    match /heroBanners/{bannerId} {

      allow read: if isAdmin()

        || resource.data.visible == true;

      allow create, update, delete: if isAdmin();
    }


    // ==========================================
    // SOCIAL LINKS SETTINGS
    // ==========================================

    match /siteSettings/{settingId} {

      // Social links are publicly readable.
      // Other settings are admin-only.
      allow read: if isAdmin()

        || settingId == 'socialLinks';

      allow create, update, delete: if isAdmin();
    }

  }
}